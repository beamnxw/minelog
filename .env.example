# TypeSafe Jev (System One). Official API: https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=

# GPT-6 Astra planner. Prefer OpenAI; OpenRouter is an optional relay.
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# PLANNER_BASE_URL=https://api.openai.com/v1
# PLANNER_MODEL=gpt-6-astra
# JEV_MODEL=jev-latest

# Vanilla Minecraft Java server the bot joins. Never grant items or change rules.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=minelog
MC_VERSION=1.20.4
MC_AUTH=offline

# Run output. runtime.log is the exact format minelog.xyz's terminal parses.
RUN_ID=local-01
RUN_DIR=./runs
